{
  "name": "universal-antislop",
  "version": "1.0.0",
  "description": "Production-ready anti-slop quality gate: parallel checkers + LLM MITM judge + Hard Gate",
  "type": "module",
  "main": "./scripts/run-checkers.mjs",
  "bin": {
    "antislop-check": "./scripts/run-checkers.mjs",
    "antislop-judge": "./scripts/judge.mjs",
    "antislop-audit": "./scripts/audit.mjs",
    "antislop-health": "./scripts/health.mjs"
  },
  "scripts": {
    "check": "node ./scripts/run-checkers.mjs",
    "judge": "node ./scripts/judge.mjs",
    "audit": "node ./scripts/audit.mjs",
    "health": "node ./scripts/health.mjs",
    "api": "node ./scripts/api.mjs",
    "loadtest": "node ./scripts/loadtest.mjs",
    "security": "node ./scripts/security-audit.mjs",
    "security:full": "node ./scripts/security-audit-full.mjs",
    "typecheck": "node ./scripts/typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint skills/",
    "auto": "node ./scripts/auto.mjs",
    "auto:scan": "node ./scripts/auto.mjs scan",
    "auto:check": "node ./scripts/auto.mjs check",
    "auto:fix": "node ./scripts/auto.mjs fix",
    "auto:fix:dry": "node ./scripts/auto.mjs fix:dry",
    "auth": "node ./scripts/auth.mjs",
    "auth:create": "node ./scripts/auth.mjs create",
    "auth:list": "node ./scripts/auth.mjs list",
    "storage": "node ./scripts/storage.mjs",
    "storage:init": "node ./scripts/storage.mjs init",
    "storage:stats": "node ./scripts/storage.mjs stats",
    "storage:backup": "node ./scripts/storage.mjs backup",
    "monitor": "node ./scripts/monitoring.mjs",
    "monitor:server": "node ./scripts/monitoring.mjs server",
    "monitor:print": "node ./scripts/monitoring.mjs print",
    "fix:ast": "node ./scripts/ast-fixer.mjs",
    "fix:babel": "node ./scripts/babel-fixer.mjs",
    "postgres:init": "node ./scripts/postgres-storage.mjs init",
    "postgres:status": "node ./scripts/postgres-storage.mjs status",
    "redis:connect": "node ./scripts/redis-cache.mjs connect",
    "redis:health": "node ./scripts/redis-cache.mjs health",
    "jwt:generate-key": "node ./scripts/jwt-auth.mjs generate-key",
    "jwt:verify-token": "node ./scripts/jwt-auth.mjs verify-token",
    "https:generate-certs": "node ./scripts/https-server.mjs generate-certs",
    "https:start": "node ./scripts/https-server.mjs start",
    "prometheus:server": "node ./scripts/prometheus-monitoring.mjs server",
    "prometheus:print": "node ./scripts/prometheus-monitoring.mjs print",
    "k8s:deploy": "kubectl apply -f k8s/",
    "k8s:delete": "kubectl delete -f k8s/",
    "prepublishOnly": "pnpm test && pnpm check",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "anti-slop",
    "code-quality",
    "ai-slop",
    "llm-judge",
    "static-analysis",
    "oxlint",
    "spectral",
    "enterprise",
    "resilience",
    "circuit-breaker"
  ],
  "author": "Raja",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raja/universal-antislop.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "scripts/",
    "skills/",
    "checkers/",
    "judge/",
    "registry.json",
    "antislop.md"
  ],
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/generator": "^7.24.0",
    "@babel/types": "^7.24.0",
    "bcryptjs": "^2.4.3",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.0",
    "prom-client": "^15.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@stoplight/spectral-cli": "^6.16.3",
    "@types/node": "^20.12.0",
    "oxlint": "^1.83.0",
    "typescript": "^5.4.5",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "node": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "node": {
      "optional": false
    }
  }
}
