{
  "name": "universal-antislop",
  "version": "1.0.0",
  "description": "Production-ready anti-slop quality gate: parallel checkers + LLM MITM judge + Hard Gate",
  "type": "module",
  "main": "./scripts/run-checkers.mjs",
  "bin": {
    "antislop-check": "./scripts/run-checkers.mjs",
    "antislop-judge": "./scripts/judge.mjs",
    "antislop-audit": "./scripts/audit.mjs",
    "antislop-health": "./scripts/health.mjs"
  },
  "scripts": {
    "check": "node ./scripts/run-checkers.mjs",
    "judge": "node ./scripts/judge.mjs",
    "audit": "node ./scripts/audit.mjs",
    "health": "node ./scripts/health.mjs",
    "api": "node ./scripts/api.mjs",
    "loadtest": "node ./scripts/loadtest.mjs",
    "security": "node ./scripts/security-audit.mjs",
    "security:full": "node ./scripts/security-audit-full.mjs",
    "typecheck": "node ./scripts/typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint skills/",
    "auto": "node ./scripts/auto.mjs",
    "auto:scan": "node ./scripts/auto.mjs scan",
    "auto:check": "node ./scripts/auto.mjs check",
    "auto:fix": "node ./scripts/auto.mjs fix",
    "auto:fix:dry": "node ./scripts/auto.mjs fix:dry",
    "prepublishOnly": "pnpm test && pnpm check",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "anti-slop",
    "code-quality",
    "ai-slop",
    "llm-judge",
    "static-analysis",
    "oxlint",
    "spectral",
    "enterprise",
    "resilience",
    "circuit-breaker"
  ],
  "author": "Raja",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raja/universal-antislop.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "scripts/",
    "skills/",
    "checkers/",
    "judge/",
    "registry.json",
    "antislop.md"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@stoplight/spectral-cli": "^6.16.3",
    "@types/node": "^20.12.0",
    "oxlint": "^1.83.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.1"
  },
  "peerDependencies": {
    "node": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "node": {
      "optional": false
    }
  }
}
